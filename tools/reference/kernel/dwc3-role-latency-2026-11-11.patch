--- a/drivers/usb/dwc3/gadget.c
+++ b/drivers/usb/dwc3/gadget.c
@@ -1865,6 +1865,28 @@
 	spin_unlock_irqrestore(&dwc->lock, flags);
 
 	free_irq(dwc->irq_gadget, dwc->ev_buf);
+
+	/*
+	 * Software unbind need not produce a disconnect event. All function
+	 * requests have been returned by unbind, and free_irq() above drains
+	 * any final reset/disconnect event before we repair the link state.
+	 * Otherwise Rockchip's role work can wait a full second for a flag
+	 * whose only event source has just been disabled.
+	 *
+	 * Never clear it merely because pullup(false) was requested: that
+	 * operation can time out. Require the controller to be stopped, or
+	 * already runtime suspended, before declaring it disconnected.
+	 */
+	spin_lock_irqsave(&dwc->lock, flags);
+	if (pm_runtime_suspended(dwc->dev) ||
+	    (!dwc->pullups_connected &&
+	     !(dwc3_readl(dwc->regs, DWC3_DCTL) & DWC3_DCTL_RUN_STOP) &&
+	     (dwc3_readl(dwc->regs, DWC3_DSTS) & DWC3_DSTS_DEVCTRLHLT))) {
+		if (dwc->connected)
+			dev_info(dwc->dev, "UDC stop: cleared stale connected after controller halt\n");
+		dwc->connected = false;
+	}
+	spin_unlock_irqrestore(&dwc->lock, flags);
 
 	return 0;
 }
