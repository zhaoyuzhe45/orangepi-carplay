 /*
+ * box: Apple vendor probes.
+ *
+ * A head unit opens the conversation with vendor requests, long before iAP2.
+ * They are addressed either to the device (wIndex 0) or to an interface index
+ * that means nothing to FunctionFS, so composite used to find no owner and
+ * stalled them; the car then went silent and never sent a single iAP2 message.
+ *
+ * Only the two static identity probes are answered here.  Requests that change
+ * state (0x52 configuration switch, 0x51 role swap) are left to whichever
+ * function claims them through req_match, because user space is the only place
+ * that knows whether such a switch is allowed right now.
+ */
+static int box_vendor_probe(const struct usb_ctrlrequest *ctrl, void *buf,
+			    u16 w_length)
+{
+	u8 *out = buf;
+
+	if (ctrl->bRequestType != 0xc0)
+		return -EOPNOTSUPP;
+
+	switch (ctrl->bRequest) {
+	case 0x53:	/* CarPlay support: 0x00000001 means "yes" */
+		if (w_length < 4)
+			return -EOPNOTSUPP;
+		out[0] = 0x01;
+		out[1] = 0x00;
+		out[2] = 0x00;
+		out[3] = 0x00;
+		return 4;
+	case 0x45:	/* usbmuxd GET_USB_MODE: 3:3:3:0 is the unswitched mode */
+		if (w_length < 4)
+			return -EOPNOTSUPP;
+		out[0] = 0x03;
+		out[1] = 0x03;
+		out[2] = 0x03;
+		out[3] = 0x00;
+		return 4;
+	}
+
+	return -EOPNOTSUPP;
+}
