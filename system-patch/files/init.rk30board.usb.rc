# USB gadget skeleton for RK3399 boards (OrangePi 4 LTS).
#
# This file only *creates* the configfs objects. It deliberately contains no
# `on property:sys.usb.config=*` handler: which functions end up in
# configuration 1, and when the UDC is bound, is owned by
# carplay_supervisor.sh.
#
# The stock handlers used to write idProduct and the Microsoft OS descriptors on
# every property flip, so a framework-driven `sys.usb.config` change could
# re-shape a gadget that was already impersonating an iPhone. With no handlers
# there is nothing to re-shape.

on boot
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x2207
    write /config/usb_gadget/g1/bcdDevice 0x0310
    write /config/usb_gadget/g1/bcdUSB 0x0200
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    # Only the accessory function is kept: it is what an Android Auto (AOA)
    # experiment would need. adb / mtp / ptp / rndis / midi are gone -- none of
    # them may ever appear next to the Apple interfaces.
    mkdir /config/usb_gadget/g1/functions/accessory.gs2
    # adbd opens /dev/usb-ffs/adb for its USB half. The function object stays so
    # adbd sees a well-formed ep0, but nothing links it into a configuration, so
    # that half can never reach a host. adbd's TCP transport is the only live
    # path (see init.usb.configfs.rc).
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    # No os_desc/b.1 symlink, no b_vendor_code, no "MSFT100".
    #
    # Those three are what made the kernel advertise a Microsoft OS 2.0 platform
    # capability in its BOS descriptor. Windows then fetched the MS OS extended
    # compatible ID and appended "RESTORE_MODE" to the hardware IDs, enumerating
    # the box as five devices, three of them with a yellow bang. A real iPhone
    # advertises nothing of the kind, so a head unit that looks at compatible
    # IDs saw a Rockchip Android device instead of an accessory.
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "fe800000.dwc3"

on property:sys.usb.config=none && property:sys.usb.configfs=1
    # Clear the leftovers of the stock state machine. The UDC write that used to
    # be here is deliberately absent: "none" is rejected with -ENODEV on this
    # kernel and leaves the controller bound, which is worse than doing nothing
    # because the next attribute writes then fail with -EBUSY.
    write /config/usb_gadget/g1/os_desc/use 0
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/bDeviceSubClass 0
    write /config/usb_gadget/g1/bDeviceProtocol 0
    setprop sys.usb.ffs.ready 0

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0
