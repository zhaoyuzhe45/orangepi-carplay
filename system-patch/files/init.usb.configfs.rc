# USB function switching is disabled on this product image.
#
# The box is a CarPlay accessory: carplay_supervisor.sh owns
# /config/usb_gadget/g1 and must be the only writer of its function list, its
# vendor/product IDs and the UDC binding.
#
# Every branch below used to symlink ffs.adb (interface class 0xFF/0x42/0x01),
# mtp, ptp, rndis or midi into configuration 1 and then bind the UDC. A head
# unit that enumerated that layout classified the box as an Android phone and
# offered Android Auto / CarLife; it never re-probed when the Apple descriptor
# replaced it seconds later. Removing the branches removes the race instead of
# racing it: no property value (adb, mtp,adb, rndis, ...) can reshape the gadget
# any more, so there is nothing for a framework-driven sys.usb.config flip to
# trip over.
#
# adbd is still wanted, but only for its TCP transport: frp publishes port 5555
# for remote maintenance. adbd keeps its functionfs endpoint (it is created by
# init.rk30board.usb.rc) but no configuration links it, so its USB half never
# reaches a host.

on boot
    # TCP transport only. Set here rather than relying on a runtime `adb tcpip`
    # call, so the maintenance channel survives a cold boot with no one on site.
    setprop service.adb.tcp.port 5555
    start adbd

on property:sys.usb.config=none && property:sys.usb.configfs=1
    # Keep the state machine from leaving stale flags behind. The UDC write and
    # the `stop adbd` that used to be here are gone on purpose: the former is
    # rejected by this kernel, the latter would kill the only remote channel.
    write /config/usb_gadget/g1/os_desc/use 0
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/bDeviceSubClass 0
    write /config/usb_gadget/g1/bDeviceProtocol 0
    setprop sys.usb.state ${sys.usb.config}

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0
